<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="EchoVid.View.MainPage"
             xmlns:platforms="clr-namespace:EchoVid.Model.Platforms"
             BackgroundColor="DarkSlateGrey"
             >

    <ContentPage.BindingContext>
        <platforms:TikTok/>
    </ContentPage.BindingContext>

    <Grid RowDefinitions="100, Auto, 100, 100"
          ColumnDefinitions=".50*, .50*"
          Padding="0"
          RowSpacing="10"
          ColumnSpacing="10">

        <Image Grid.ColumnSpan="2"
               Source="logo.png"
               BackgroundColor="LightSeaGreen"/>

        <Button Text="Login with TikTok"
                Grid.ColumnSpan="2"
                Grid.Row="1"
                Padding="20"
                FontSize="Large"
                FontAutoScalingEnabled="True"
                Margin="10"
                Clicked="TikTokLogin_Clicked"
                />

        <Button Text="{Binding Authenticated}"
               Grid.Row="2"
               FontSize="22"/>



    </Grid>

</ContentPage>
